  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamlucianojr/pi-go-review.git"
  },
  "homepage": "https://github.com/iamlucianojr/pi-go-review#readme",
  "bugs": {
    "url": "https://github.com/iamlucianojr/pi-go-review/issues"
  },
  "files": ["extensions", "README.md", "LICENSE"],
  "pi": {
    "extensions": ["./extensions"]
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
